# Production environment settings
DJANGO_ENV=production

# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-production-secret-key-here

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# AWS RDS PostgreSQL (Production)
DB_PROD_NAME=homefield
DB_PROD_USER=your_db_user
DB_PROD_PASSWORD=your_db_password
DB_PROD_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PROD_PORT=5432

# Generic DB vars for wait-for-rds service
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
